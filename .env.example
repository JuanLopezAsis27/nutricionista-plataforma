# =========================================================================
# Plantilla de variables de entorno.
# Copiá este archivo a .env y completá los valores reales.
# NUNCA commitees el archivo .env (está en .gitignore).
# =========================================================================

# --- PostgreSQL (usado por docker-compose) ---
POSTGRES_USER=nutricionista
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=nutricionista
POSTGRES_PORT=5432

# --- Prisma / aplicación ---
# DESARROLLO LOCAL (la DB corre en docker-compose.yml, app fuera de Docker):
#   el host es "localhost".
DATABASE_URL="postgresql://nutricionista:cambiame_en_local@localhost:5432/nutricionista?schema=public"
#
# PRODUCCIÓN (docker-compose.prod.yml, app y DB en la misma red de Docker):
#   el host es el nombre del servicio "postgres". Descomentá y usá esta:
# DATABASE_URL="postgresql://nutricionista:cambiame_en_local@postgres:5432/nutricionista?schema=public"

# --- Auth.js v5 ---
# Generá un secreto con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="genera_un_secreto_largo_y_aleatorio"
# URL pública de la app (en producción, el dominio real con https).
AUTH_URL="http://localhost:3000"

# --- App (producción) ---
# Puerto del host donde se publica la app (docker-compose.prod.yml).
APP_PORT=3000

# --- Almacenamiento de archivos (S3-compatible) ---
# DESARROLLO: MinIO de docker-compose.yml (consola web en http://localhost:9001).
# PRODUCCIÓN: puede apuntarse a AWS S3 / Cloudflare R2 cambiando solo estas variables.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=cambiame_en_local
S3_BUCKET=nutricionista
S3_REGION=us-east-1
# MinIO exige path-style; en AWS S3 real puede ponerse en false.
S3_FORCE_PATH_STYLE=true

# --- Email (SMTP) ---
# DESARROLLO: Mailpit de docker-compose.yml (UI en http://localhost:8025).
# PRODUCCIÓN: SMTP real (ej. Gmail con contraseña de aplicación, o un proveedor transaccional).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Lic. López Asis <no-responder@localhost>"

# --- Integraciones externas (Google Calendar + Gmail) ---
# Clave para cifrar los tokens OAuth guardados (AES-256-GCM, CifradorTokens).
# Debe ser una cadena larga y aleatoria. Generá una con: openssl rand -base64 32
TOKENS_SECRET="genera_otra_clave_larga_y_aleatoria_distinta_del_auth_secret"
#
# Credenciales OAuth de Google Cloud (pantalla de consentimiento + cliente OAuth).
# Si NO se completan, la integración queda deshabilitada y la app funciona igual
# (emails por SMTP, sin sincronización de calendario).
# En Google Cloud, registrá como URI de redireccionamiento autorizado:
#   {APP_URL}/api/integraciones/google/callback   (ej: http://localhost:3000/api/integraciones/google/callback)
# Scopes usados: calendar.events y gmail.send (son "sensibles" → requieren verificación de Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública de la app (base para el redirect de OAuth). En prod, el dominio real.
APP_URL="http://localhost:3000"

# --- Microservicio de ML (opcional) ---
# URL del servicio de ML (ver carpeta ml-servicio/). Si NO se completa, la app
# usa los stubs de demostración (insights y análisis de comida) y funciona igual.
# El servicio lee una RÉPLICA DE SOLO LECTURA de esta misma base para las features.
ML_SERVICE_URL=
# Token opcional (Bearer) para autenticar la app contra el servicio de ML.
ML_SERVICE_TOKEN=

# --- IA con Claude (asistente + análisis de foto de comida) ---
# El profesional puede cargar su API key de Anthropic DESDE LA APP
# (Configuración → Integraciones), guardada cifrada. Esta variable de entorno es
# un fallback global (útil en un despliegue de un solo nutricionista).
# IMPORTANTE: debe ser una key de Anthropic (empieza con `sk-ant-`); una key de
# otro proveedor (p. ej. OpenRouter `sk-or-...`) NO sirve con el cliente por
# defecto. Sin key en ningún lado, esas funciones quedan en demostración (stubs).
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-opus-5. Para bajar costo/latencia:
# claude-sonnet-5 o claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Datos nutricionales de ingredientes (Open Food Facts) ---
# El recetario autocompleta los macros de cada ingrediente desde Open Food Facts
# (gratis, SIN API key). Está HABILITADO por defecto. Para desactivarlo (offline,
# o si preferís carga 100% manual), poné NUTRICION_DESHABILITADA=true.
# NUTRICION_DESHABILITADA=false
# Base del API (subdominio de idioma). Por defecto español; se puede cambiar.
# OFF_BASE_URL=https://es.openfoodfacts.org

# --- Ingredientes: FatSecret Platform (opcional) ---
# Alternativa a Open Food Facts para los macros de ingredientes. El profesional
# puede cargar estas credenciales DESDE LA APP (Configuración → Integraciones,
# cifradas). Estas variables son un fallback global. Si el inquilino tiene
# FatSecret configurado, se usa FatSecret; si no, Open Food Facts.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- Microservicio de nutrición (opcional, ver carpeta nutricion-servicio/) ---
# Servicio Go (AWS Lambda o HTTP) que hace de intermediario con FatSecret: busca,
# TRADUCE los ingredientes ES↔EN y los FILTRA según criterio. Si NO se completa
# NUTRICION_SERVICE_URL, la app usa el proveedor local (FatSecret directo por
# inquilino / Open Food Facts) y funciona igual. Si el servicio falla o no trae
# resultados, la app cae al proveedor local automáticamente (degradación).
NUTRICION_SERVICE_URL=
# Token compartido (Bearer). Debe coincidir con el del servicio Go.
NUTRICION_SERVICE_TOKEN=

# --- Worker de trabajos en segundo plano ---
# Zona horaria de los crons (recordatorios, alertas).
TZ=America/Argentina/Buenos_Aires

# --- Semilla (opcional) ---
# Credenciales del SUPERADMIN (gestiona las cuentas de nutricionista) y del primer
# NUTRICIONISTA demo que crea `npm run db:seed`.
SUPERADMIN_EMAIL=admin@demo.com
SUPERADMIN_PASSWORD=cambiar123
SEED_EMAIL=nutricionista@demo.com
SEED_PASSWORD=cambiar123

# --- Monitoreo de errores (opcional) ---
# Los errores no esperados SIEMPRE se registran en los logs (consola / docker logs).
# Si además querés recibir un aviso, poné acá la URL de un webhook entrante de
# Slack, Discord o un colector propio. Se envía un POST JSON con el resumen del
# error. Dejar vacío para no enviar nada.
# MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# --- Entorno ---
NODE_ENV="development"
