# Variables del microservicio de ML. Copiar a .env.

# Token que exige a la app (mismo valor que ML_SERVICE_TOKEN en el .env de la app).
# Dejar vacío para no exigir auth (solo en local/red privada).
ML_SERVICE_TOKEN=

# Réplica de SOLO LECTURA de la base de la app (nunca la primaria de producción).
DATABASE_URL_RO=postgresql://lector:cambiame@localhost:5432/nutricionista

# Bucket S3/MinIO para descargar las fotos de comida (mismas credenciales que la app).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=cambiame_en_local
S3_BUCKET=nutricionista
S3_REGION=us-east-1
