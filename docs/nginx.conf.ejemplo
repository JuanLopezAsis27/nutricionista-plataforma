# =============================================================================
# nginx como reverse proxy de la app (corre en el HOST del VPS, no en Docker).
# La app publica su puerto solo en localhost (docker-compose.prod.yml →
# 127.0.0.1:3000). nginx termina TLS y proxea a ese puerto.
#
# Instalar:
#   sudo cp docs/nginx.conf.ejemplo /etc/nginx/sites-available/nutricionista
#   # editá `server_name` con tu dominio real
#   sudo ln -s /etc/nginx/sites-available/nutricionista /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS (Let's Encrypt):
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d tudominio.com
#   (certbot agrega los `ssl_certificate*` y el redirect 80→443 automáticamente y
#    renueva solo con un timer de systemd)
# =============================================================================

# =============================================================================
# Límites de tasa (contexto http).
#
# IMPORTANTE: estas dos directivas `limit_req_zone` NO van dentro de `server`.
# Si copiás este archivo a sites-available tal cual, movelas a /etc/nginx/nginx.conf
# dentro del bloque `http { ... }`, o nginx no arranca.
#
# La app ya limita en memoria (login, recuperación de contraseña, monitoreo,
# IA), pero ese estado se pierde en cada reinicio y no se comparte si algún día
# hay más de una réplica. El límite de nginx está POR DELANTE, sobrevive a los
# reinicios de la app y frena el tráfico antes de que llegue a gastar CPU.
#
# $binary_remote_addr y no $http_x_forwarded_for: la dirección real de la
# conexión, que el cliente no puede falsear.
# =============================================================================
limit_req_zone $binary_remote_addr zone=autenticacion:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;

# Al superar el límite, 429 (y no el 503 por defecto): es lo que corresponde y
# lo que los clientes saben interpretar.
limit_req_status 429;

# --- HTTP: redirige a HTTPS (certbot suele generarlo; si no, dejá este bloque) ---
server {
    listen 80;
    listen [::]:80;
    server_name tudominio.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name tudominio.com;

    # certbot completa estas dos líneas al correr `certbot --nginx`:
    # ssl_certificate     /etc/letsencrypt/live/tudominio.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tudominio.com/privkey.pem;

    # Subida de archivos: el módulo Archivos limita a 10 MB; damos margen.
    # (nginx por defecto corta en 1 MB → sin esto fallan las subidas.)
    client_max_body_size 16m;

    # Seguridad básica.
    #
    # Estas cabeceras las emite AHORA la propia aplicación (next.config.ts →
    # headers()), junto con la CSP, Referrer-Policy y Permissions-Policy que acá
    # no estaban. Se dejan igual como segunda capa: si algún día la app se sirve
    # con otra configuración, el proxy sigue poniendo el piso.
    #
    # nginx no duplica una cabecera que ya viene del upstream salvo que se use
    # `always`; si ves valores repetidos en una respuesta, sacá las de acá y
    # dejá las de la app, que son las más completas.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Sonda de salud (GET /api/salud). Devuelve 200 si la app llega a Postgres
    # y 503 si no. Es pública y no expone detalles del error.
    #
    # Útil para monitoreo externo (UptimeRobot, Healthchecks.io) apuntando acá.
    # Se le quitan los logs de acceso para que un sondeo cada 30 s no inunde el
    # archivo, y se marca no-cacheable: una sonda que responde desde el caché
    # no verifica nada.
    location = /api/salud {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache off;
        access_log off;
    }

    # Autenticación: el objetivo natural de la fuerza bruta y del bombardeo de
    # correo. 10 por minuto por IP, con un colchón de 5 para no castigar el
    # reintento legítimo de alguien que se equivocó de contraseña.
    #
    # Cubre /api/auth/* (login de Auth.js). La recuperación de contraseña entra
    # por /api/trpc, así que además tiene su propio límite en la app
    # (LimitadorTasa) — acá no se puede distinguir un procedimiento de otro.
    location /api/auth {
        limit_req zone=autenticacion burst=5 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Ingesta de errores del cliente: pública y sin sesión, así que también con
    # límite propio (la app la limita igual, pero esto llega antes).
    location = /api/monitoreo {
        limit_req zone=autenticacion burst=10 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=general burst=60 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Cabeceras estándar de reverse proxy.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Soporte para Upgrade (por si se usa en el futuro).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # CRÍTICO: la app usa notificaciones en tiempo real por SSE (tRPC
    # subscriptions sobre /api/trpc). nginx BUFEA las respuestas por defecto, lo
    # que ROMPE el stream (los eventos no llegan hasta cerrar la conexión). Para
    # las rutas de tRPC desactivamos el buffering y alargamos el timeout.
    location /api/trpc {
        # Mismo límite general. El stream SSE es UNA sola request (larga), así
        # que un límite por tasa no lo afecta: cuenta conexiones nuevas, no
        # tiempo conectado.
        limit_req zone=general burst=60 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;        # no bufear (SSE)
        proxy_cache off;
        proxy_read_timeout 24h;     # el stream vive mucho tiempo
        chunked_transfer_encoding off;
    }
}
