# =========================================================================
# PRODUCCIÓN — copiá a  .env.produccion  y completá los valores reales.
# NUNCA commitees el archivo real (está en .gitignore).
# Se usa con:  docker compose -p nutri_prod --env-file .env.produccion \
#                 -f docker-compose.prod.yml --profile respaldos up -d --build
# =========================================================================

# --- Red / reverse proxy ---
# nginx (en el host) proxea a este puerto de localhost. La app NO se expone afuera.
# En staging usá otro puerto (ej. 3001) para que convivan en el mismo VPS.
APP_PORT=3000

# --- Discos ---
# Punto de montaje del DISCO SECUNDARIO donde vive el bucket MinIO (fotos, PDFs).
# Es la carpeta del disco extra que montaste en el VPS (ver docs/DESPLIEGUE.md).
RUTA_BUCKET=/mnt/bucket/minio

# --- PostgreSQL (DISCO PRINCIPAL) ---
POSTGRES_USER=nutricionista
POSTGRES_PASSWORD=CAMBIAME_clave_fuerte
POSTGRES_DB=nutricionista
# host = "postgres" (nombre del servicio en la red interna del stack).
DATABASE_URL=postgresql://nutricionista:CAMBIAME_clave_fuerte@postgres:5432/nutricionista?schema=public

# --- Auth.js ---
# Generá con: openssl rand -base64 32
AUTH_SECRET=CAMBIAME_secreto_largo_aleatorio
AUTH_URL=https://tudominio.com
APP_URL=https://tudominio.com

# --- Almacenamiento (MinIO interno de este stack) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nutricionista_minio
S3_SECRET_KEY=CAMBIAME_clave_minio_fuerte
S3_BUCKET=nutricionista
S3_REGION=us-east-1

# --- Email (SMTP real) ---
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=tu_usuario
SMTP_PASS=tu_password
SMTP_SECURE=false
EMAIL_FROM=Lic. López Asis <turnos@tudominio.com>
NOMBRE_PROFESIONAL=Lic. López Asis Nicolás

# --- Integraciones (opcionales; si faltan, la app degrada) ---
# Cifrado de tokens de Google (openssl rand -base64 32).
TOKENS_SECRET=CAMBIAME_otra_clave_distinta
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ML corre en OTRO entorno (nube on-demand). Cuando esté, poné su URL acá.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
# IA con Claude (chat del paciente + análisis de foto de comida). Si se completa,
# usan Claude con degradación al stub; si no, quedan como demostración.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5   # o claude-sonnet-5 / claude-haiku-4-5 (menor costo)
# Open Food Facts está habilitado por defecto (gratis, sin key).
# NUTRICION_DESHABILITADA=false

# --- Worker (crons en hora local) ---
TZ=America/Argentina/Buenos_Aires

# --- Semilla inicial (solo el primer arranque) ---
SUPERADMIN_EMAIL=admin@tudominio.com
# En producción la semilla EXIGE estas variables y un mínimo de 12 caracteres:
# si faltan, aborta en vez de crear el superadmin con una contraseña de ejemplo.
SUPERADMIN_PASSWORD=CAMBIAME_clave_fuerte
SEED_EMAIL=profesional@tudominio.com
SEED_PASSWORD=CAMBIAME_clave_fuerte

# --- Respaldos OFFSITE (OVH Object Storage, S3-compatible) ---
# Creá un contenedor Object Storage en OVH y una clave S3 (usuario S3).
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_ACCESS_KEY=CAMBIAME
OVH_S3_SECRET_KEY=CAMBIAME
OVH_S3_BUCKET=nutricionista-respaldos
OVH_S3_REGION=gra
# Días de retención de los dumps de la base (local y offsite).
# --- Cifrado de respaldos ---
# Identidad GPG (clave PÚBLICA) con la que se cifra el volcado de la base ANTES
# de subirlo a OVH. La clave PRIVADA no va en el VPS: sin ella el archivo del
# bucket externo no sirve de nada, ni para quien controle el servidor.
#
#   # en tu máquina:  gpg --full-generate-key && gpg --armor --export vos@correo > clave.asc
#   # en el VPS:      GNUPGHOME=/etc/nutricionista/llaves gpg --import clave.asc
#
# Si se deja vacía, el respaldo funciona pero sale SIN CIFRAR y avisa en el log.
RESPALDO_GPG_RECIPIENT=
# Directorio del host con el llavero GPG (se monta de solo lectura).
RUTA_LLAVES_GPG=/etc/nutricionista/llaves

# --- Credenciales de aplicación para MinIO ---
# Service account acotada para que la app NO use la credencial de administración
# del bucket. Ver .env.example para el comando que la crea.
S3_APP_ACCESS_KEY=
S3_APP_SECRET_KEY=

RETENCION_DIAS=14
# Hora local del respaldo diario.
HORA_RESPALDO=03:00
