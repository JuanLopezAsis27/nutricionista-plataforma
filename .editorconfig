# Convenciones básicas del editor. Complementa a Prettier (.prettierrc), que
# resuelve el formato del código; esto cubre lo que Prettier no toca.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
