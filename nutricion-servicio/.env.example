# --- Servicio de nutrición (Go / AWS Lambda) ---
# Copiar a .env para correr en local:  cp .env.example .env

# FatSecret Platform (OAuth2 client credentials).
# Sacar de https://platform.fatsecret.com/  (Manage → Credentials).
# OJO: FatSecret exige whitelistear la IP saliente (IP Restrictions). En Lambda,
# la IP es dinámica salvo que la pongas detrás de un NAT Gateway con IP fija.
FATSECRET_CLIENT_ID=05eaac7280954062995212948b33a0e9
FATSECRET_CLIENT_SECRET=32f536ceced74b63985d299613a62af6

# OpenRouter — para traducir ES<->EN los ingredientes (formato OpenAI-compatible).
# Si se deja vacío, el servicio NO traduce (devuelve los nombres en inglés).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Token compartido con la app (ProveedorNutricionHTTP manda Authorization: Bearer <token>).
# Si se deja vacío, el endpoint queda SIN autenticación (solo para desarrollo).
NUTRICION_SERVICE_TOKEN=

# Solo local: si está seteado, corre como servidor HTTP en ese puerto en vez de Lambda.
LOCAL_PORT=8080
