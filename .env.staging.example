# =========================================================================
# STAGING (mismo VPS) — copiá a  .env.staging  y completá.
# Aislado de producción por proyecto Docker (-p nutri_staging): su propia base,
# su propio bucket y su propia red interna. Comparte el VPS y el nginx del host.
# Se usa con:  docker compose -p nutri_staging --env-file .env.staging \
#                 -f docker-compose.prod.yml up -d --build     (SIN --profile respaldos)
# =========================================================================

# --- Red / reverse proxy ---
# Puerto de localhost distinto al de prod, así conviven en el mismo VPS.
# En nginx, agregá un server{} para staging.tudominio.com que proxee a este puerto.
APP_PORT=3001

# --- Discos ---
# Bucket de staging (datos descartables): puede ir en el disco principal.
RUTA_BUCKET=/srv/staging/minio

# --- PostgreSQL (aislada de prod por proyecto) ---
POSTGRES_USER=nutricionista
POSTGRES_PASSWORD=staging_clave
POSTGRES_DB=nutricionista
DATABASE_URL=postgresql://nutricionista:staging_clave@postgres:5432/nutricionista?schema=public

# --- Auth.js ---
AUTH_SECRET=CAMBIAME_secreto_staging
AUTH_URL=https://staging.tudominio.com
APP_URL=https://staging.tudominio.com

# --- Almacenamiento (MinIO de staging) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=staging_minio
S3_SECRET_KEY=staging_minio_clave
S3_BUCKET=nutricionista
S3_REGION=us-east-1

# --- Email ---
# ⚠️ IMPORTANTE: staging NO debe mandar emails a pacientes reales.
# Usá un SMTP de prueba (Mailpit, Mailtrap) o dejá datos de prueba en la base.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Staging <staging@tudominio.com>
NOMBRE_PROFESIONAL=Staging

# --- Integraciones ---
TOKENS_SECRET=CAMBIAME_staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
# IA con Claude (opcional en staging). Sin key, usa los stubs de demostración.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Worker ---
TZ=America/Argentina/Buenos_Aires

# --- Semilla ---
SUPERADMIN_EMAIL=admin@staging.local
SUPERADMIN_PASSWORD=staging123
SEED_EMAIL=profesional@staging.local
SEED_PASSWORD=staging123
