# =========================================================================
# STAGING (VPS PROPIO) — copiá a  .env.staging  y completá.
#
# Staging corre en un servidor separado del de producción. Se despliega solo:
# cada merge a `development` dispara el despliegue a este entorno.
#
# Se usa con:  ./scripts/desplegar.sh staging
#   (que agrega --profile correo-prueba para levantar Mailpit, y NO
#    --profile respaldos: staging no necesita copias de seguridad)
# =========================================================================

# --- Red / reverse proxy ---
# En un VPS propio no hay que esquivar el puerto de producción: 3000 está libre.
# (Era 3001 cuando prod y staging compartían máquina.)
# En nginx, un server{} para staging.tudominio.com que proxee a este puerto.
APP_PORT=3000

# --- Discos ---
# Bucket de staging (datos descartables): puede ir en el disco principal.
RUTA_BUCKET=/srv/staging/minio

# --- PostgreSQL (aislada de prod por proyecto) ---
POSTGRES_USER=nutricionista
POSTGRES_PASSWORD=staging_clave
POSTGRES_DB=nutricionista
DATABASE_URL=postgresql://nutricionista:staging_clave@postgres:5432/nutricionista?schema=public

# --- Auth.js ---
AUTH_SECRET=CAMBIAME_secreto_staging
AUTH_URL=https://staging.tudominio.com
APP_URL=https://staging.tudominio.com

# --- Almacenamiento (MinIO de staging) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=staging_minio
S3_SECRET_KEY=staging_minio_clave
S3_BUCKET=nutricionista
S3_REGION=us-east-1

# --- Email ---
# ⚠️ CRÍTICO: staging NO debe mandar emails a pacientes reales.
#
# El worker de staging corre los mismos crons que producción, incluido el
# recordatorio diario de turnos. Cuando restaures un dump de producción para
# probar la recuperación, este entorno va a tener direcciones de pacientes
# reales: con un SMTP que entregue, el cron de la mañana siguiente les escribe.
#
# `mailpit` es el servicio del compose que levanta `desplegar.sh staging` con
# --profile correo-prueba. Acepta todo y no entrega nada. NO lo cambies por un
# sink externo (Mailtrap y similares): con datos clínicos restaurados, mandaría
# nombres, emails y teléfonos de pacientes a un tercero.
#
# Para ver los correos capturados:  ssh -L 8025:localhost:8025 staging
#                                   y abrí http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Staging <staging@tudominio.com>
NOMBRE_PROFESIONAL=Staging

# --- Integraciones ---
TOKENS_SECRET=CAMBIAME_staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ML: corre como contenedor del stack, en la red interna (perfil `ml`).
# Vacío = la app usa los stubs de demostración y funciona igual.
# Antes de habilitarlo, leé el comentario del servicio `ml` en el compose:
# hay que verificar la RAM libre y crear el rol con scripts/crear-rol-ml.sql.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
# Conexión de SOLO LECTURA que usa el servicio de ML (rol ml_lector).
DATABASE_URL_RO=
# IA con Claude (opcional en staging). Sin key, usa los stubs de demostración.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Worker ---
TZ=America/Argentina/Buenos_Aires

# --- Monitoreo ---
# Webhook al que se envían los errores no esperados (Slack/Discord/colector).
# En staging conviene apuntarlo a un canal DISTINTO al de producción, para que
# el ruido de las pruebas no entrene a nadie a ignorar las alertas reales.
MONITOR_WEBHOOK_URL=

# Puerto local de la UI de Mailpit (se publica sólo en 127.0.0.1).
MAILPIT_UI_PORT=8025

# --- Semilla ---
SUPERADMIN_EMAIL=admin@staging.local
SUPERADMIN_PASSWORD=staging123
SEED_EMAIL=profesional@staging.local
SEED_PASSWORD=staging123
